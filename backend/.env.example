PORT=8080
MONGODB_URL=mongodb://localhost:27017/campusfound
# Used for CORS and for links in emails
FRONTEND_URL=http://localhost:5173
# Optional: comma separated extra origins allowed by CORS
CORS_ORIGINS=

JWT_SECRET=change_me
JWT_EXPIRE_IN=15m
JWT_REFRESH_SECRET=change_me_too
JWT_REFRESH_EXPIRE_IN=7d

EMAIL_USER=
EMAIL_PASS=

# Optional: photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: restrict signups, e.g. college.edu,student.college.edu
ALLOWED_EMAIL_DOMAINS=

# Email on hosts that block SMTP (e.g. Render free): Brevo API key + a verified sender
BREVO_API_KEY=
MAIL_FROM=
